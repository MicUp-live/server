#!/usr/bin/env bash
#MISE description="Build ARM64 catalog garbage collection Lambda package"
set -euo pipefail

mkdir -p dist/catalog-gc
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o dist/catalog-gc/bootstrap ./cmd/catalog-gc
(cd dist/catalog-gc && touch -t 198001010000 bootstrap && python3 -m zipfile -c ../catalog-gc.zip bootstrap)
