#!/usr/bin/env bash
#MISE description="Build ARM64 import reconciler Lambda package"
set -euo pipefail

mkdir -p dist/import-reconciler
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o dist/import-reconciler/bootstrap ./cmd/import-reconciler
(cd dist/import-reconciler && touch -t 198001010000 bootstrap && python3 -m zipfile -c ../import-reconciler.zip bootstrap)
