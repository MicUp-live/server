#!/usr/bin/env bash
#MISE description="Serve the API through the local Lambda and HTTP API emulator"
#MISE depends=["local:bootstrap", "build:lambda-local"]
set -euo pipefail

exec env AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local   sam local start-api   --template-file local/sam-template.yaml   --docker-network micup-local   --env-vars local/sam-env.json   --region us-east-2   --warm-containers lazy   --port 9000 "$@"
