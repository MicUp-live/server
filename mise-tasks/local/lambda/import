#!/usr/bin/env bash
#MISE description="Invoke the import Lambda with a production-shaped SQS event"
#MISE depends=["local:bootstrap", "build:lambda-local"]
set -euo pipefail

exec env AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local   sam local invoke ImportWorker   --template-file local/sam-template.yaml   --docker-network micup-local   --env-vars local/sam-env.json   --region us-east-2   --event local/events/import-sqs.json "$@"
