#!/usr/bin/env bash
#MISE description="Verify the local PostgreSQL, S3, SQS, and SES resources"
#MISE depends=["local:bootstrap"]
set -euo pipefail

export AWS_ACCESS_KEY_ID=local
export AWS_SECRET_ACCESS_KEY=local
docker compose exec -T postgres pg_isready -U micup -d micup >/dev/null
aws s3api head-bucket --bucket micup-app-local --endpoint-url http://127.0.0.1:4566
aws sqs get-queue-url --queue-name micup-local-catalog-build --endpoint-url http://127.0.0.1:4566 --output text >/dev/null
aws sqs get-queue-url --queue-name micup-local-import-jobs --endpoint-url http://127.0.0.1:4566 --output text >/dev/null
aws ses get-identity-verification-attributes --identities noreply@micup.live --endpoint-url http://127.0.0.1:4566 --output text >/dev/null
echo "Local production simulation is ready."
