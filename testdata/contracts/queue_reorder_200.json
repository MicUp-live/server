{
  "contract_id": "C03",
  "description": "POST /api/v1/events/{id}/requests/reorder manual queue reorder with expected_queue_version, Idempotency-Key, X-Queue-Version header bump, and unknown future field tolerance",
  "request": {
    "method": "POST",
    "path": "/api/v1/events/evt_contract_01/requests/reorder",
    "required_scope": "requests:write",
    "headers": {
      "Authorization": "Bearer mk_live_contract_requests_write",
      "Content-Type": "application/json",
      "Idempotency-Key": "11111111-2222-4333-8444-555555555504"
    },
    "body": {
      "order": [
        "req_contract_02",
        "req_contract_01"
      ],
      "expected_queue_version": 10,
      "future_reorder_hint": "manual_drag_drop"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "X-Queue-Version": "11"
    },
    "body": {
      "status": "ok"
    }
  },
  "expected_active_order_after": [
    "req_contract_02",
    "req_contract_01"
  ]
}
